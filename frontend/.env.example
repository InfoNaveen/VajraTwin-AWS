# Copy this file to .env.local and fill in your deployed API Gateway URL.
# Vite exposes any variable prefixed with VITE_ to the browser bundle.
#
# Local SAM testing:
# VITE_API_GATEWAY_URL=http://127.0.0.1:3000
#
# Deployed (replace with your sam deploy output):
# VITE_API_GATEWAY_URL=https://abc123xyz.execute-api.ap-south-1.amazonaws.com/dev

VITE_API_GATEWAY_URL=http://127.0.0.1:3000
